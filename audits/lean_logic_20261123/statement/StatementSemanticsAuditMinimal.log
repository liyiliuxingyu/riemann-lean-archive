def RiemannHypothesis : Prop :=
∀ (s : ℂ), riemannZeta s = 0 → (¬∃ n, s = -2 * (↑n + 1)) → s ≠ 1 → s.re = 1 / 2
def riemannZeta : ℂ → ℂ :=
HurwitzZeta.hurwitzZetaEven 0
DirichletCharacter.LFunction {N : ℕ} [NeZero N] (χ : DirichletCharacter ℂ N) (s : ℂ) : ℂ
@[defeq] theorem StatementSemanticsAudit.advertised_zeta_statement_eq_mathlib : RiemannZetaZerosOnLine =
  RiemannHypothesis :=
rfl
theorem StatementSemanticsAudit.advertised_zeta_statement_iff_mathlib : RiemannZetaZerosOnLine ↔ RiemannHypothesis :=
Iff.rfl
